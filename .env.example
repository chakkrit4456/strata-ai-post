# ===== AI (ฟรีทั้งหมด) — ลองตามลำดับ ถ้าเจ้าแรกโควตาหมด/ล่ม จะสลับไปเจ้าถัดไปเอง =====
AI_PROVIDERS=gemini,groq,openrouter
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://openrouter.ai/keys (ใช้โมเดลที่ลงท้าย :free — ใส่หลายตัวคั่นด้วย , เป็นตัวสำรองได้)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# ===== ภาพและธีม =====
# ภาพประกอบจาก AI (ฟรี): pollinations ไม่ต้องใช้คีย์ / gemini ใช้ได้เมื่อมีโควตาภาพ / off = ปิด
AI_IMAGE_PROVIDERS=gemini,pollinations
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# ธีมโพสต์อัตโนมัติ: mix (ธีมเพจทุกๆ N โพสต์ ที่เหลือสุ่ม) | random | brand
THEME_MODE=mix
THEME_BRAND_EVERY=3
# ดึงข่าวล่าสุดมาใช้คิดโพสต์ตามเทรนด์
USE_NEWS=true

# ===== Facebook Page (Graph API) =====
FB_PAGE_ID=1393910303809343
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v26.0

# ===== การทำงาน =====
TIMEZONE=Asia/Bangkok
# true = โพสต์เพจต้องกดอนุมัติใน Dashboard ก่อน (แนะนำช่วง 2 สัปดาห์แรก)
REQUIRE_APPROVAL=true
DATA_DIR=./data
# (ไม่บังคับ) โฟลเดอร์ภาพพื้นหลัง (เช่น ภาพ abstract ที่สร้างจาก AI) ระบบจะสุ่มใช้
BG_IMAGE_DIR=

# ===== Dashboard =====
HOST=0.0.0.0
PORT=8787
PUBLIC_URL=http://localhost:8787
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-too

# ===== Telegram (ไม่บังคับ) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
